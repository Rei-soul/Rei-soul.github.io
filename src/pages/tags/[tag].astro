---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import PageBanner from '../../components/PageBanner.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={`标签：${tag}`} description={`标签「${tag}」下的全部文章`}>
  <PageBanner wallpaper="/wallpapers/blog.svg" title={`#${tag}`} command={`git show tag/${tag}`} subtitle={`共 ${sorted.length} 篇`} />
  <div class="glass-rise mx-auto max-w-5xl px-4 pb-8 pt-10 md:pt-12">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {sorted.map((post, i) => <PostCard post={post} index={i} />)}
    </div>
  </div>
</Base>
