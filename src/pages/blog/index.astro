---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import PageBanner from '../../components/PageBanner.astro';

const PAGE_SIZE = 6;
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.kind === 'tech'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pageOne = posts.slice(0, PAGE_SIZE);
const hasMore = posts.length > PAGE_SIZE;
---

<Base title="文章" description="Rei-soul 的技术文章：计算机系统、深度学习、C++ 与项目复盘。">
  <PageBanner
    wallpaper="/wallpapers/blog.svg"
    title="文章"
    command="ls ~/posts --category=tech"
    subtitle={`共 ${posts.length} 篇技术文章。学习笔记、论文复现与项目复盘。`}
  />
  <div class="glass-rise mx-auto max-w-5xl px-4 pb-8 pt-10 md:pt-12">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {pageOne.map((post, i) => <PostCard post={post} index={i} />)}
    </div>

    {
      hasMore && (
        <nav class="mt-12 flex items-center justify-center gap-1.5 font-mono text-sm" aria-label="分页">
          <span class="px-3 py-1.5 rounded-lg border border-line opacity-30 select-none">←</span>
          {Array.from({ length: Math.ceil(posts.length / PAGE_SIZE) }, (_, i) => i + 1).map((n) =>
            n === 1 ? (
              <span class="px-3 py-1.5 rounded-lg border border-accent text-accent bg-accent-soft select-none">1</span>
            ) : (
              <a href={`/blog/page/${n}/`} class="px-3 py-1.5 rounded-lg border border-line text-fg-mute hover:text-accent hover:border-accent transition-colors">
                {n}
              </a>
            )
          )}
          <a href="/blog/page/2/" class="px-3 py-1.5 rounded-lg border border-line text-fg-mute hover:text-accent hover:border-accent transition-colors">
            →
          </a>
        </nav>
      )
    }
  </div>
</Base>
