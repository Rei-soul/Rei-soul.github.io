---
import Base from '../layouts/Base.astro';
import { PROJECTS, GROUP_LABEL, type Project } from '../data/projects';
import PageBanner from '../components/PageBanner.astro';

// 构建期尝试用 GitHub API 刷新 star 数与更新时间（CI 中有 GITHUB_TOKEN）。
// 本地无网络/超时/限流时回落到 src/data/projects.ts 的静态数据，构建永远不失败。
async function fetchRemote(): Promise<Map<string, { stars: number; pushed: string }>> {
  const map = new Map<string, { stars: number; pushed: string }>();
  try {
    const headers: Record<string, string> = { Accept: 'application/vnd.github+json' };
    const token = import.meta.env.GITHUB_TOKEN;
    if (token) headers.Authorization = `Bearer ${token}`;
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 2500);
    const res = await fetch('https://api.github.com/users/Rei-soul/repos?per_page=100&sort=updated', {
      headers,
      signal: ctrl.signal,
    });
    clearTimeout(timer);
    if (!res.ok) return map;
    const repos = (await res.json()) as Array<{ name: string; stargazers_count: number; pushed_at: string }>;
    for (const r of repos) map.set(r.name, { stars: r.stargazers_count, pushed: r.pushed_at.slice(0, 10) });
  } catch {
    /* 静态兜底 */
  }
  return map;
}

// dev 模式跳过远程拉取：本地预览时 GitHub API 网络等待（最长数秒）会阻塞
// 页面渲染，导致切到本页明显卡顿；直接使用静态数据即可。
// 只有真正构建（npm run build / CI）时才联网刷新。
const remote = import.meta.env.DEV
  ? new Map<string, { stars: number; pushed: string }>()
  : await fetchRemote();

const projects: Array<Project & { pushed?: string }> = PROJECTS.map((p) => ({
  ...p,
  stars: remote.get(p.name)?.stars ?? p.stars,
  pushed: remote.get(p.name)?.pushed,
}));

const groups: Array<Project['group']> = ['course', 'lab', 'side'];
const langColor: Record<string, string> = {
  C: '#a8b9cc',
  'C++': '#f34b7d',
  Python: '#3572a5',
  Java: '#b07219',
  HTML: '#e34c26',
};
---

<Base title="项目" description="Rei-soul 的 GitHub 项目：课程学习、论文复现与课余小项目。">
  <PageBanner
    wallpaper="/wallpapers/projects.svg"
    title="项目"
    command="git remote -v && gh repo list"
    subtitle="课程学习、论文复现与课余小项目。star 数与更新时间在每次构建时自动同步。"
  />
  <div class="glass-rise mx-auto max-w-5xl px-4 pb-8 pt-10 md:pt-12">
    <p class="text-sm text-fg-mute" data-reveal>
      代码都在
      <a href="https://github.com/Rei-soul?tab=repositories" target="_blank" rel="noopener" class="text-accent hover:underline underline-offset-4">GitHub ↗</a>
    </p>

    {groups.map((group, gi) => {
      const list = projects.filter((p) => p.group === group).sort((a, b) => Number(b.featured ?? false) - Number(a.featured ?? false));
      if (!list.length) return null;
      return (
        <section class="mt-14">
          <div class="flex items-center gap-3 mb-6" data-reveal>
            <h2 class="font-kai text-xl font-semibold">{GROUP_LABEL[group]}</h2>
            <div class="flex-1 border-t border-dashed border-line" />
            <span class="font-mono text-xs text-fg-mute">{list.length}</span>
          </div>

          <div class="grid gap-5 md:grid-cols-2">
            {list.map((p, i) => (
              <a
                href={p.url}
                target="_blank"
                rel="noopener"
                data-reveal
                style={`--reveal-delay:${Math.min(i, 5) * 80}ms`}
                class={`post-card rounded-xl p-5 flex flex-col ${p.featured ? 'md:col-span-2' : ''}`}
              >
                <div class="flex items-center gap-2.5">
                  <span class="font-mono font-bold text-[0.95rem] group-hover:text-accent">{p.name}</span>
                  <span
                    class="w-2 h-2 rounded-full shrink-0"
                    style={`background:${langColor[p.lang] ?? 'var(--fg-mute)'}`}
                    title={p.lang}
                    aria-hidden="true"
                  />
                  <span class="font-mono text-xs text-fg-mute">{p.lang}</span>
                  <span class="ml-auto font-mono text-xs text-fg-mute flex items-center gap-1" title="Stars">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                      <path d="M12 2 15 9l7 .6-5.3 4.6L18.2 21 12 17.3 5.8 21l1.5-6.8L2 9.6 9 9Z" />
                    </svg>
                    {p.stars}
                  </span>
                </div>
                <p class="text-sm text-fg-mute mt-3 leading-relaxed">{p.desc}</p>
                <p class="mt-auto pt-3 font-mono text-xs text-fg-mute opacity-70">
                  {p.pushed ? `最近更新 ${p.pushed}` : '—'}
                </p>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</Base>
