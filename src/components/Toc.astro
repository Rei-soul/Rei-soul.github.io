---
// 文章目录（桌面端右侧吸附）。当前阅读位置高亮由 main.ts 驱动。
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav id="toc" class="soft-card rounded-xl p-5 text-sm" aria-label="文章目录">
      <p class="font-mono text-xs text-fg-mute mb-3 select-none">## 目录</p>
      <ul class="space-y-1">
        {items.map((h) => (
          <li class={h.depth === 3 ? 'pl-4' : ''}>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class="block py-0.5 text-fg-mute hover:text-accent transition-colors truncate"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
