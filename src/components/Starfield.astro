---
// 首屏背景星空 canvas：细小星点缓慢漂移 + 少量琥珀色"暖星"（人文点缀）
// 尊重 prefers-reduced-motion（静态一帧）、页面不可见时自动暂停
---

<canvas class="absolute inset-0 h-full w-full" data-starfield aria-hidden="true"></canvas>

<script>
  interface Star {
    x: number;
    y: number;
    z: number; // 视差层级 0.2~1
    r: number;
    warm: boolean;
    phase: number;
    freq: number;
    amp: number;
  }

  function initStarfield() {
    document.querySelectorAll<HTMLCanvasElement>('[data-starfield]:not([data-done])').forEach((canvas) => {
      canvas.setAttribute('data-done', '');
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let stars: Star[] = [];
      let raf = 0;

      const build = () => {
        const { clientWidth: w, clientHeight: h } = canvas;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = Math.min(150, Math.floor((w * h) / 8500));
        stars = Array.from({ length: count }, () => ({
          x: Math.random() * w,
          y: Math.random() * h,
          z: 0.25 + Math.random() * 0.75,
          r: 0.4 + Math.random() * 1.2,
          warm: Math.random() < 0.09,
          phase: Math.random() * Math.PI * 2,
          freq: 0.4 + Math.random() * 0.8,
          amp: 0.15 + Math.random() * 0.25,
        }));
      };

      const draw = (t: number) => {
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        ctx.clearRect(0, 0, w, h);
        const dark = document.documentElement.classList.contains('dark');
        const base = dark ? 0.5 : 0.32;
        for (const s of stars) {
          s.x -= 0.045 * s.z;
          s.y += 0.02 * s.z;
          if (s.x < -2) s.x = w + 2;
          if (s.y > h + 2) s.y = -2;
          const tw = base + s.amp * (0.5 + 0.5 * Math.sin(t * 0.001 * s.freq + s.phase));
          ctx.beginPath();
          ctx.fillStyle = s.warm
            ? `rgba(240, 168, 76, ${tw})`
            : `rgba(170, 205, 235, ${tw})`;
          ctx.arc(s.x, s.y, s.r * s.z + 0.25, 0, Math.PI * 2);
          ctx.fill();
        }
      };

      const loop = (t: number) => {
        if (!canvas.isConnected) return;
        if (!document.hidden) draw(t);
        raf = requestAnimationFrame(loop);
      };

      build();
      if (reduced) {
        draw(0); // 静态一帧
      } else {
        raf = requestAnimationFrame(loop);
      }

      const onResize = () => {
        build();
        if (reduced) draw(0);
      };
      window.addEventListener('resize', onResize);
    });
  }

  document.addEventListener('astro:page-load', initStarfield);
</script>
