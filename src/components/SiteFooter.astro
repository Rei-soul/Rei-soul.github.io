---
import { SITE, SOCIAL } from '../data/site';

const year = new Date().getFullYear();

const iconMap: Record<string, string> = {
  github:
    '<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.91c.58.1.79-.25.79-.55v-2.1c-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.18-1.49 3.14-1.18 3.14-1.18.63 1.58.24 2.75.12 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.66.41.36.77 1.05.77 2.13v3.16c0 .3.2.66.8.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>',
  rss: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none"/></svg>',
  email:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>',
};
---

<footer class="border-t border-line mt-24">
  <div class="mx-auto max-w-5xl px-4 py-12 grid gap-10 md:grid-cols-3 text-sm">
    <!-- 品牌 -->
    <div>
      <p class="font-mono font-bold">
        <span class="text-accent">&gt;_</span> {SITE.title}
      </p>
      <p class="mt-2.5 text-fg-mute font-kai leading-relaxed">{SITE.tagline}</p>
      <div class="mt-4 flex items-center gap-3 text-fg-mute">
        {SOCIAL.map((s) => (
          <a href={s.url} class="hover:text-accent transition-colors" aria-label={s.name} title={s.name} set:html={iconMap[s.icon]} />
        ))}
      </div>
    </div>

    <!-- 一言：随机一句话（人文点缀，由 main.ts 异步填充） -->
    <div class="font-kai text-fg-mute leading-relaxed">
      <p id="hitokoto">玻璃晴朗，橘子辉煌。</p>
      <p id="hitofrom" class="mt-1.5 text-xs opacity-70"></p>
    </div>

    <!-- 统计信息 -->
    <div class="font-mono text-xs text-fg-mute leading-7 md:text-right">
      <p>© {year} {SITE.author}</p>
      <p>
        建站 <span id="site-days">—</span> 天
        <span class="mx-1 opacity-40">|</span>
        <span id="busuanzi_container_site_pv" class="busuanzi_container">访问 <span id="busuanzi_value_site_pv" class="busuanzi_value">…</span></span>
        <span class="mx-1 opacity-40">|</span>
        <span id="busuanzi_container_site_uv" class="busuanzi_container">访客 <span id="busuanzi_value_site_uv" class="busuanzi_value">…</span></span>
      </p>
      <p>
        Powered by <a class="hover:text-accent transition-colors" href="https://astro.build" target="_blank" rel="noopener">Astro</a>
        <span class="mx-1 opacity-40">·</span>
        <a class="hover:text-accent transition-colors" href="/rss.xml">RSS</a>
      </p>
    </div>
  </div>
</footer>
