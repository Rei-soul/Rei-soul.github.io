---
// 站内搜索弹窗（Ctrl+K / 顶部按钮唤起）。
// 索引由 Pagefind 在 npm run build 时生成：dev 模式下没有索引，会提示需先构建。
---

<dialog id="search-dialog" class="rounded-2xl border border-line shadow-2xl p-0 w-[min(92vw,620px)]" style="background: var(--bg-soft); color: var(--fg);">
  <div class="p-4">
    <div class="search-inputbar flex items-center gap-2.5 border-b border-line pb-3">
      <svg class="w-4 h-4 text-fg-mute shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="搜索文章标题与内容…"
        autocomplete="off"
        class="flex-1 bg-transparent outline-none text-[0.95rem] placeholder:text-fg-mute"
      />
      <kbd class="font-mono text-[0.7rem] border border-line rounded px-1.5 py-0.5 text-fg-mute">ESC</kbd>
    </div>
    <div id="search-results" class="mt-3 max-h-[52vh] overflow-y-auto text-sm"></div>
    <div class="mt-3 pt-2.5 border-t border-line flex items-center justify-between font-mono text-[0.7rem] text-fg-mute">
      <span>Ctrl K 唤起</span>
      <span>Pagefind 静态索引</span>
    </div>
  </div>
</dialog>
