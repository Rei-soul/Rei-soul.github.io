---
// 明暗主题切换按钮：点击后以按钮为圆心做圆形扩散动画（见 main.ts / global.css）
---

<button
  class="theme-toggle p-2 rounded-lg text-fg-mute hover:text-accent transition-colors"
  aria-label="切换深浅色主题"
  title="切换深浅色主题"
>
  <!-- 太阳（深色模式下显示，点击切到浅色） -->
  <svg class="dark:hidden w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <!-- 月亮（浅色模式下显示，点击切到深色） -->
  <svg class="hidden dark:block w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>
